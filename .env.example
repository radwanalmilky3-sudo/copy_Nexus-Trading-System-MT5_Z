# NEXUS TRADER MT5 — نموذج متغيرات البيئة (Template)
# ------------------------------------------------------------
# انسخ هذا الملف إلى .env واملأ القيم المحلية. هذا الملف نموذج فقط:
# لا يحتوي أي قيم حقيقية ولا يجوز وضع أسرار حقيقية فيه أو إيصاله لـgit.
# القاعدة الذهبية: NEXUS_TRADING_MODE=paper افتراضياً — الرفع للحي قرار مالك صريح.

# ── الأمان (ولّد قيماً عشوائية طويلة محلياً؛ لا تشاركها أبداً) ──
# يجب أن تختلف NEXUS_RISK_APPROVAL_SECRET عن NEXUS_INTERNAL_API_SECRET (عزل توقيع الموافقات).
NEXUS_CONFIG_CONTRACT=warn
NEXUS_SECRET_KEY=change-me-random-64hex
NEXUS_JWT_SECRET=change-me-random-64hex
NEXUS_INTERNAL_API_SECRET=change-me-random-32hex
NEXUS_RISK_APPROVAL_SECRET=change-me-different-32hex

# ── الجلسات (D14/D15، دورة 2026-11-05) ──
# access 24h + refresh 168h (7 أيام)؛ كل توكن يحمل jti ويُبطل خادمياً بعد logout
# عبر denylist في Redis (nexus:auth:denylist:<jti>). /api/v2/auth/refresh يدوّر
# الزوج single-use. تقييد المعدل: 12/60s للدخول، 30/60s للتجديد.
NEXUS_JWT_EXPIRE_HOURS=24
NEXUS_JWT_REFRESH_EXPIRE_HOURS=168
NEXUS_REFRESH_RATE_WINDOW_SEC=60
NEXUS_REFRESH_RATE_LIMIT=30

# ── مزوّد LLM للوكلاء (D6، دورة 2026-11-05) ──
# تباعد بدايات نداءات LLM على مستوى العملية (ثوانٍ) — يمنع انفجار 429 لدى
# المزوّد السحابي؛ 0 يعطّل التباعد. عند 429 يُنتظر backoff ×4 (سقف 32s).
NEXUS_LLM_MIN_INTERVAL_SEC=1.0

# ── وضع التداول (paper فقط افتراضياً) ──
NEXUS_TRADING_MODE=paper

# ── التخزين ──
REDIS_URL=redis://127.0.0.1:6379/0
DUCKDB_PATH=data/nexus.duckdb

# ── الداشبورد (منشأ CORS للبوابة) ──
DASHBOARD_ORIGIN=http://localhost:3100

# ── التسجيل ──
LOG_LEVEL=info

# ── حساب المالك الأول (bootstrap يُنشأ مرة واحدة؛ غيّرها قبل أول إقلاع) ──
NEXUS_ADMIN_PIN=change-me-6digits
NEXUS_ADMIN_PASSWORD=change-me-strong-password

# ── مزود LLM المحلي ──
NEXUS_LLM_PROVIDER=local
NEXUS_LLM_MODEL=change-me-model-name

# ── مفتاح مزود LLM السحابي (اختياري — لخدمة الوكلاء 9004 فقط) ──
ZAI_API_KEY=

# ── النسخ الاحتياطي المشفر ──
BACKUP_PASSPHRASE=change-me-passphrase

# ── T-024: REAL cloud market data via CCXT public endpoints (paper/dev) ──
# Set ENABLE_CCXT=1 to ingest REAL exchange candles without MT5.
# XAUUSD maps to PAXG/USDT (tokenized gold on Binance — honest real-time
# gold proxy). Public market data needs NO API key; keys remain optional
# for keyed endpoints. Synthetic data stays forbidden.
# ENABLE_CCXT=1
# CCXT_EXCHANGE=binance
# CCXT_SYMBOL_MAP=XAUUSD:PAXG/USDT
# CCXT_POLL_SEC=45
